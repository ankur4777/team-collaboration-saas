# Copy this file to .env for local development. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
DB_ENGINE=mysql
MYSQL_DATABASE=teamworkspace
MYSQL_USER=teamworkspace
MYSQL_PASSWORD=local-development-password-change-me
MYSQL_ROOT_PASSWORD=local-root-password-change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_URL=redis://redis:6379/0
DEFAULT_FROM_EMAIL=TeamWorkspace <noreply@example.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Account recovery links: reset 1 hour; verification 24 hours.
PASSWORD_RESET_TIMEOUT=3600
# For production set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and configure SMTP host/user/password securely outside GitHub.


# Local mail works immediately between local mailbox accounts in one workspace.
MAIL_LOCAL_ENABLED=true
# OAuth requires a stable Fernet key, generated as described in docs/EMAIL_SETUP.md.
MAIL_TOKEN_ENCRYPTION_KEY=
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
MAIL_MICROSOFT_CLIENT_ID=
MAIL_MICROSOFT_CLIENT_SECRET=
MAIL_MICROSOFT_TENANT=common
MAIL_CALLBACK_ORIGIN=http://localhost:5173
