# Copy this file to .env for local development. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
DB_ENGINE=mysql
MYSQL_DATABASE=teamworkspace
MYSQL_USER=teamworkspace
MYSQL_PASSWORD=local-development-password-change-me
MYSQL_ROOT_PASSWORD=local-root-password-change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_URL=redis://redis:6379/0
DEFAULT_FROM_EMAIL=TeamWorkspace <noreply@example.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
